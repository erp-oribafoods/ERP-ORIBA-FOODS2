<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ORIBA FOODS - Commercial — Tableau de bord commercial</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <style>
    :root {
      --rouge: #D71920;
      --rouge-dim: #a91217;
      --vert: #0B8F3A;
      --vert-dim: #086b2b;
      --encre: #17181D;
      --encre-soft: #2b2d35;
      --papier: #F6F5F1;
      --carte: #FFFFFF;
      --ligne: #E4E2DA;
      --texte: #1c1d22;
      --texte-mute: #6b6d78;
      --ambre: #C97A1B;
      --radius: 10px;
      --shadow: 0 1px 2px rgba(23,24,29,.04), 0 8px 24px -12px rgba(23,24,29,.12);
      --font-display: 'Space Grotesk', sans-serif;
      --font-body: 'Manrope', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }
    [data-theme="dark"] {
      --encre: #F6F5F1;
      --papier: #121317;
      --carte: #1a1b21;
      --ligne: #2c2e36;
      --texte: #EDECE7;
      --texte-mute: #9294a1;
      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px -12px rgba(0,0,0,.5);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--font-body);
      background: var(--papier);
      color: var(--texte);
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
      transition: background .25s ease, color .25s ease;
    }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; cursor: pointer; }
    :focus-visible { outline: 2px solid var(--rouge); outline-offset: 2px; }
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-thumb { background: var(--ligne); border-radius: 8px; }

    .shell { display: grid; grid-template-columns: 236px 1fr; min-height: 100vh; }
    @media (max-width: 900px) { .shell { grid-template-columns: 0 1fr; } }

    .sidebar {
      background: var(--encre); color: #eceae2; position: sticky; top: 0; height: 100vh;
      overflow-y: auto; padding: 20px 12px; display: flex; flex-direction: column;
      transition: transform .25s ease;
    }
    @media (max-width: 900px) {
      .sidebar { position: fixed; z-index: 60; width: 236px; transform: translateX(-100%); }
      .sidebar.open { transform: translateX(0); }
    }
    .brand { display: flex; align-items: center; gap: 10px; padding: 6px 8px 22px 8px; }
    .brand .mark {
      width: 34px; height: 34px; border-radius: 8px;
      background: linear-gradient(135deg, var(--rouge), var(--vert));
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display); font-weight: 700; color: #fff; font-size: 15px;
    }
    .brand .name { font-family: var(--font-display); font-weight: 700; font-size: 15.5px; letter-spacing: .2px; }
    .brand .name small { display: block; font-family: var(--font-mono); font-weight: 400; font-size: 10px; color: #9a9c9a; letter-spacing: .5px; }
    
    .navgroup { margin-top: 10px; }
    .navgroup .label { font-size: 10.5px; text-transform: uppercase; letter-spacing: 1.2px; color: #7d7f78; padding: 14px 10px 6px; }
    .navitem {
      display: flex; align-items: center; gap: 11px; padding: 9px 10px; border-radius: 8px;
      color: #c9c8c2; font-size: 13.3px; font-weight: 500; cursor: pointer; position: relative;
    }
    .navitem i { width: 16px; text-align: center; font-size: 14px; color: #8f9089; }
    .navitem:hover { background: #212228; color: #fff; }
    .navitem.active { background: linear-gradient(90deg, rgba(215,25,32,.22), rgba(215,25,32,0)); color: #fff; }
    .navitem.active i { color: var(--rouge); }
    .navitem.active::before { content: ''; position: absolute; left: -12px; top: 6px; bottom: 6px; width: 3px; background: var(--rouge); border-radius: 2px; }
    .navitem .count { margin-left: auto; font-family: var(--font-mono); font-size: 10.5px; background: #2a2c32; color: #c9c8c2; padding: 1px 6px; border-radius: 20px; }
    .sidebar-foot { margin-top: auto; padding: 12px 10px 4px; font-size: 11px; color: #767870; font-family: var(--font-mono); }

    .topbar {
      position: sticky; top: 0; z-index: 40; background: var(--carte); border-bottom: 1px solid var(--ligne);
      display: flex; align-items: center; gap: 14px; padding: 11px 22px;
    }
    .burger { display: none; background: none; border: none; font-size: 18px; color: var(--texte); }
    @media (max-width: 900px) { .burger { display: block; } }
    .searchbar {
      flex: 1; max-width: 420px; display: flex; align-items: center; gap: 8px;
      background: var(--papier); border: 1px solid var(--ligne); border-radius: 8px; padding: 8px 12px;
    }
    .searchbar i { color: var(--texte-mute); font-size: 12.5px; }
    .searchbar input { background: none; border: none; outline: none; width: 100%; color: var(--texte); font-size: 13px; }
    .topbar-right { display: flex; align-items: center; gap: 6px; margin-left: auto; }
    .clock { font-family: var(--font-mono); font-size: 12px; color: var(--texte-mute); padding: 0 10px; text-align: right; line-height: 1.3; }
    .clock b { color: var(--texte); font-weight: 600; display: block; }
    .icon-btn {
      width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--ligne); background: var(--carte);
      display: flex; align-items: center; justify-content: center; color: var(--texte-mute); font-size: 14px; position: relative;
    }
    .icon-btn:hover { color: var(--texte); border-color: var(--texte-mute); }
    .userchip { display: flex; align-items: center; gap: 9px; padding: 5px 10px 5px 6px; border-radius: 30px; border: 1px solid var(--ligne); margin-left: 4px; }
    .userchip .av { width: 26px; height: 26px; border-radius: 50%; background: var(--vert); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; font-family: var(--font-display); }
    .userchip .who { line-height: 1.15; }
    .userchip .who b { display: block; font-size: 12.3px; }
    .userchip .who span { font-size: 10.5px; color: var(--texte-mute); }

    .content { padding: 22px 26px 60px; max-width: 1400px; }
    .page { display: none; }
    .page.active { display: block; animation: fadein .35s ease; }
    @keyframes fadein { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    .pagehead { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 18px; flex-wrap: wrap; }
    .pagehead h1 { font-family: var(--font-display); font-size: 22px; font-weight: 700; }
    .pagehead .eyebrow { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--rouge); margin-bottom: 4px; }
    .pagehead p { color: var(--texte-mute); font-size: 12.8px; margin-top: 3px; }
    .head-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .btn {
      display: inline-flex; align-items: center; gap: 7px; padding: 9px 14px; border-radius: 8px; font-size: 12.8px; font-weight: 600;
      border: 1px solid var(--ligne); background: var(--carte); color: var(--texte);
    }
    .btn:hover { border-color: var(--texte-mute); }
    .btn.primary { background: var(--rouge); border-color: var(--rouge); color: #fff; }
    .btn.primary:hover { background: var(--rouge-dim); }
    .btn.green { background: var(--vert); border-color: var(--vert); color: #fff; }
    .btn.green:hover { background: var(--vert-dim); }

    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
    @media (max-width: 1100px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .kpi-grid { grid-template-columns: 1fr; } }
    .kpi {
      background: var(--carte); border: 1px solid var(--ligne); border-radius: var(--radius); padding: 16px 16px 14px;
      position: relative; overflow: hidden; box-shadow: var(--shadow);
    }
    .kpi::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--track, var(--vert)); }
    .kpi .klabel { font-size: 11px; text-transform: uppercase; letter-spacing: .7px; color: var(--texte-mute); font-weight: 600; }
    .kpi .kval { font-family: var(--font-display); font-size: 26px; font-weight: 700; margin-top: 6px; letter-spacing: -.2px; }

    .panel { background: var(--carte); border: 1px solid var(--ligne); border-radius: var(--radius); padding: 18px; margin-bottom: 18px; box-shadow: var(--shadow); }
    .panel h3 { font-family: var(--font-display); font-size: 14.5px; font-weight: 700; margin-bottom: 2px; }
    .panel .pnote { font-size: 11.5px; color: var(--texte-mute); margin-bottom: 14px; }
    .grid2 { display: grid; grid-template-columns: 1.3fr 1fr; gap: 16px; }
    @media (max-width: 980px) { .grid2 { grid-template-columns: 1fr; } }

    .tablewrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 12.6px; }
    thead th {
      text-align: left; font-size: 10.5px; text-transform: uppercase; letter-spacing: .6px; color: var(--texte-mute);
      padding: 8px 10px; border-bottom: 1px solid var(--ligne); white-space: nowrap;
    }
    tbody td { padding: 9px 10px; border-bottom: 1px solid var(--ligne); white-space: nowrap; }
    tbody tr:hover { background: rgba(11,143,58,.045); }

    .dropzone {
      border: 2px dashed var(--ligne); border-radius: var(--radius); background: var(--carte); padding: 44px 20px;
      text-align: center; transition: .2s; cursor: pointer;
    }
    .dropzone i { font-size: 30px; color: var(--vert); margin-bottom: 10px; }
    .dropzone input { display: none; }
    .chart-box { position: relative; height: 260px; }
    .chart-box.tall { height: 320px; }

    .formgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
    .field label { font-size: 11.5px; font-weight: 600; color: var(--texte-mute); display: block; margin-bottom: 5px; }
    .field input, .field select { width: 100%; border: 1px solid var(--ligne); background: var(--papier); border-radius: 7px; padding: 8px 10px; font-size: 12.5px; color: var(--texte); }

    .toast { position: fixed; bottom: 22px; right: 22px; z-index: 200; display: flex; flex-direction: column; gap: 8px; }
    .toast .t { background: var(--encre); color: #fff; padding: 11px 16px; border-radius: 8px; font-size: 12.6px; display: flex; align-items: center; gap: 9px; box-shadow: var(--shadow); }
    .toast .t i { color: var(--vert); }
  </style>
</head>
<body>
<div class="shell">
  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="mark">OF</div>
      <div class="name">ORIBA FOODS<small>SUIVI COMMERCIAL DADI</small></div>
    </div>
    <div class="navgroup">
      <div class="label">Pilotage</div>
      <div class="navitem active" data-page="dashboard"><i class="fa-solid fa-gauge-high"></i>Tableau de bord</div>
    </div>
    <div class="navgroup">
      <div class="label">Performance</div>
      <div class="navitem" data-page="produits"><i class="fa-solid fa-jar"></i>Produits</div>
      <div class="navitem" data-page="zones"><i class="fa-solid fa-map-location-dot"></i>Zones</div>
      <div class="navitem" data-page="marches"><i class="fa-solid fa-store"></i>Marchés</div>
    </div>
    <div class="navgroup">
      <div class="label">Données</div>
      <div class="navitem" data-page="import"><i class="fa-solid fa-file-arrow-up"></i>Importation Excel</div>
    </div>
    <div class="sidebar-foot">v1.1 · Sauvegarde permanente</div>
  </aside>

  <!-- MAIN MAIN -->
  <div>
    <header class="topbar">
      <button class="burger" id="burgerBtn"><i class="fa-solid fa-bars"></i></button>
      <div class="searchbar">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input id="globalSearch" type="text" placeholder="Rechercher un produit, une zone, un marché...">
      </div>
      <div class="topbar-right">
        <div class="clock"><b id="clockTime">--:--</b><span id="clockDate">--</span></div>
        <div class="userchip">
          <div class="av">AD</div>
          <div class="who"><b>Abdoul Djalil</b><span>Responsable Commercial</span></div>
        </div>
      </div>
    </header>

    <main class="content">
      <!-- DASHBOARD PAGE -->
      <section class="page active" id="page-dashboard">
        <div class="pagehead">
          <div>
            <div class="eyebrow">Vue d'ensemble</div>
            <h1>Tableau de bord commercial</h1>
            <p>Aperçu général des ventes et des encaissements sur le réseau DADI.</p>
          </div>
          <div class="head-actions">
            <button class="btn" onclick="goTo('import')"><i class="fa-solid fa-file-arrow-up"></i>Importer</button>
            <button class="btn primary" onclick="window.print()"><i class="fa-solid fa-print"></i>Imprimer</button>
          </div>
        </div>

        <div class="kpi-grid">
          <div class="kpi" style="--track: var(--vert)">
            <div class="klabel">Total Prises</div>
            <div class="kval" id="kpiPrises">0 FCFA</div>
          </div>
          <div class="kpi" style="--track: var(--vert)">
            <div class="klabel">Total Versements</div>
            <div class="kval" id="kpiVersements">0 FCFA</div>
          </div>
          <div class="kpi" style="--track: var(--ambre)">
            <div class="klabel">Taux d'Encaissement</div>
            <div class="kval" id="kpiTaux">0%</div>
          </div>
          <div class="kpi" style="--track: var(--rouge)">
            <div class="klabel">Reste à Encaisser</div>
            <div class="kval" id="kpiReste">0 FCFA</div>
          </div>
        </div>

        <div class="grid2">
          <div class="panel">
            <h3>Synthèse des Performances</h3>
            <div class="pnote">Distribution des encaissements</div>
            <div class="chart-box tall"><canvas id="chartRepartition"></canvas></div>
          </div>
          <div class="panel">
            <h3>Zones Majeures</h3>
            <div class="pnote">Total des prises par zone</div>
            <div class="chart-box tall"><canvas id="chartZones"></canvas></div>
          </div>
        </div>
      </section>

      <!-- IMPORT & SAISIE PAGE -->
      <section class="page" id="page-import">
        <div class="pagehead">
          <div><div class="eyebrow">Données</div><h1>Importation &amp; Saisie Directe</h1></div>
        </div>

        <div class="dropzone" id="dropzone">
          <input type="file" id="fileInput" accept=".xlsx,.xls">
          <i class="fa-solid fa-cloud-arrow-up"></i>
          <h4>Glissez-déposez votre fichier Excel</h4>
          <p>ou cliquez pour parcourir</p>
        </div>

        <div class="panel" style="margin-top:20px;">
          <h3><i class="fa-solid fa-keyboard"></i> Saisie manuelle directe</h3>
          <p class="pnote">Ajoutez vos transactions ligne par ligne. Tout est conservé dans le navigateur.</p>
          <div class="formgrid" style="margin-top:15px;">
            <div class="field"><label>Date</label><input type="date" id="mDate"></div>
            <div class="field"><label>Produit</label><input type="text" id="mProduit" placeholder="Ex: Dadi Épice"></div>
            <div class="field"><label>Zone</label><input type="text" id="mZone" placeholder="Ex: Niamey 1"></div>
            <div class="field"><label>Marché</label><input type="text" id="mMarche" placeholder="Ex: Grand Marché"></div>
            <div class="field"><label>Prises (FCFA)</label><input type="number" id="mPrises" placeholder="0"></div>
            <div class="field"><label>Versements (FCFA)</label><input type="number" id="mVersements" placeholder="0"></div>
          </div>
          <button class="btn green" id="saveManualBtn" style="margin-top:15px;"><i class="fa-solid fa-save"></i> Enregistrer la ligne</button>
        </div>
      </section>

      <!-- PRODUITS PAGE -->
      <section class="page" id="page-produits">
        <div class="pagehead"><div><h1>Produits</h1></div></div>
        <div class="panel">
          <div class="tablewrap">
            <table id="tblProduits">
              <thead><tr><th>Produit</th><th>Prises</th><th>Versements</th><th>Reste à Encaisser</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ZONES PAGE -->
      <section class="page" id="page-zones">
        <div class="pagehead"><div><h1>Zones</h1></div></div>
        <div class="panel">
          <div class="tablewrap">
            <table id="tblZones">
              <thead><tr><th>Zone</th><th>Prises</th><th>Versements</th><th>Reste à Encaisser</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- MARCHES PAGE -->
      <section class="page" id="page-marches">
        <div class="pagehead"><div><h1>Marchés</h1></div></div>
        <div class="panel">
          <div class="tablewrap">
            <table id="tblMarches">
              <thead><tr><th>Marché</th><th>Prises</th><th>Versements</th><th>Reste à Encaisser</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>

<div class="toast" id="toastBox"></div>

<script>
// ==================== ENGINE & STATE ====================
const STORAGE_KEY = 'ORIBA_COMMERCIAL_DATABASE_V1';
let appData = {
  sales: []
};

function loadAppData() {
  const stored = localStorage.getItem(STORAGE_KEY);
  if (stored) {
    try {
      appData = JSON.parse(stored);
    } catch(e) {
      console.error("Erreur de lecture du localStorage", e);
    }
  }
}

function saveData() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
  renderAllData();
  showToast("Modifications enregistrées !");
}

function showToast(message) {
  const container = document.getElementById('toastBox');
  const t = document.createElement('div');
  t.className = 't';
  t.innerHTML = `<i class="fa-solid fa-circle-check"></i> ${message}`;
  container.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

// ==================== ROUTING ====================
function goTo(pageId) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.navitem').forEach(n => n.classList.remove('active'));
  
  const targetPage = document.getElementById('page-' + pageId);
  if (targetPage) targetPage.classList.add('active');
  
  const navItem = document.querySelector(`.navitem[data-page="${pageId}"]`);
  if (navItem) navItem.classList.add('active');
}

document.querySelectorAll('.navitem').forEach(item => {
  item.addEventListener('click', () => {
    const p = item.getAttribute('data-page');
    if (p) goTo(p);
  });
});

// ==================== RENDERING & CHARTS ====================
let chartRep, chartZones;

function renderAllData() {
  let totalPrises = 0;
  let totalVersements = 0;

  const produitsMap = {};
  const zonesMap = {};
  const marchesMap = {};

  appData.sales.forEach(item => {
    const p = Number(item.prises) || 0;
    const v = Number(item.versements) || 0;
    
    totalPrises += p;
    totalVersements += v;

    // Aggregats Produit
    if (!produitsMap[item.produit]) produitsMap[item.produit] = { prises: 0, versements: 0 };
    produitsMap[item.produit].prises += p;
    produitsMap[item.produit].versements += v;

    // Aggregats Zone
    if (!zonesMap[item.zone]) zonesMap[item.zone] = { prises: 0, versements: 0 };
    zonesMap[item.zone].prises += p;
    zonesMap[item.zone].versements += v;

    // Aggregats Marché
    if (!marchesMap[item.marche]) marchesMap[item.marche] = { prises: 0, versements: 0 };
    marchesMap[item.marche].prises += p;
    marchesMap[item.marche].versements += v;
  });

  const reste = totalPrises - totalVersements;
  const taux = totalPrises > 0 ? ((totalVersements / totalPrises) * 100).toFixed(1) : 0;

  document.getElementById('kpiPrises').innerText = totalPrises.toLocaleString() + ' FCFA';
  document.getElementById('kpiVersements').innerText = totalVersements.toLocaleString() + ' FCFA';
  document.getElementById('kpiReste').innerText = reste.toLocaleString() + ' FCFA';
  document.getElementById('kpiTaux').innerText = taux + '%';

  populateTables(produitsMap, zonesMap, marchesMap);
  renderCharts(produitsMap, zonesMap);
}

function populateTables(prodMap, zoneMap, marchMap) {
  // Tableau Produits
  const pBody = document.querySelector('#tblProduits tbody');
  pBody.innerHTML = '';
  Object.keys(prodMap).forEach(k => {
    const d = prodMap[k];
    pBody.innerHTML += `<tr><td><b>${k}</b></td><td>${d.prises.toLocaleString()} FCFA</td><td>${d.versements.toLocaleString()} FCFA</td><td>${(d.prises - d.versements).toLocaleString()} FCFA</td></tr>`;
  });

  // Tableau Zones
  const zBody = document.querySelector('#tblZones tbody');
  zBody.innerHTML = '';
  Object.keys(zoneMap).forEach(k => {
    const d = zoneMap[k];
    zBody.innerHTML += `<tr><td><b>${k}</b></td><td>${d.prises.toLocaleString()} FCFA</td><td>${d.versements.toLocaleString()} FCFA</td><td>${(d.prises - d.versements).toLocaleString()} FCFA</td></tr>`;
  });

  // Tableau Marchés
  const mBody = document.querySelector('#tblMarches tbody');
  mBody.innerHTML = '';
  Object.keys(marchMap).forEach(k => {
    const d = marchMap[k];
    mBody.innerHTML += `<tr><td><b>${k}</b></td><td>${d.prises.toLocaleString()} FCFA</td><td>${d.versements.toLocaleString()} FCFA</td><td>${(d.prises - d.versements).toLocaleString()} FCFA</td></tr>`;
  });
}

function renderCharts(prodMap, zoneMap) {
  // Graphique Doughnut
  const ctx1 = document.getElementById('chartRepartition').getContext('2d');
  const prodLabels = Object.keys(prodMap);
  const prodData = prodLabels.map(k => prodMap[k].versements);

  if (chartRep) chartRep.destroy();
  chartRep = new Chart(ctx1, {
    type: 'doughnut',
    data: {
      labels: prodLabels.length ? prodLabels : ['Aucune donnée'],
      datasets: [{
        data: prodData.length ? prodData : [1],
        backgroundColor: ['#D71920', '#0B8F3A', '#C97A1B', '#2b2d35', '#7d7f78']
      }]
    },
    options: { responsive: true, maintainAspectRatio: false }
  });

  // Graphique Barres
  const ctx2 = document.getElementById('chartZones').getContext('2d');
  const zoneLabels = Object.keys(zoneMap);
  const zoneData = zoneLabels.map(k => zoneMap[k].prises);

  if (chartZones) chartZones.destroy();
  chartZones = new Chart(ctx2, {
    type: 'bar',
    data: {
      labels: zoneLabels.length ? zoneLabels : ['Aucune zone'],
      datasets: [{
        label: 'Prises (FCFA)',
        data: zoneData.length ? zoneData : [0],
        backgroundColor: '#0B8F3A'
      }]
    },
    options: { responsive: true, maintainAspectRatio: false }
  });
}

// ==================== SAISIE & EXCEL ====================
document.getElementById('saveManualBtn').addEventListener('click', () => {
  const p = document.getElementById('mProduit').value.trim();
  const z = document.getElementById('mZone').value.trim();
  const m = document.getElementById('mMarche').value.trim();
  const prises = document.getElementById('mPrises').value;
  const versements = document.getElementById('mVersements').value;

  if (!p || !z) {
    alert("Veuillez saisir au minimum un produit et une zone.");
    return;
  }

  appData.sales.push({
    date: document.getElementById('mDate').value || new Date().toISOString().split('T')[0],
    produit: p,
    zone: z,
    marche: m || 'Général',
    prises: Number(prises) || 0,
    versements: Number(versements) || 0
  });

  saveData();

  // Reinitialisation du formulaire
  document.getElementById('mProduit').value = '';
  document.getElementById('mZone').value = '';
  document.getElementById('mMarche').value = '';
  document.getElementById('mPrises').value = '';
  document.getElementById('mVersements').value = '';
});

// Lecture des fichiers Excel
const dz = document.getElementById('dropzone');
const fi = document.getElementById('fileInput');

dz.addEventListener('click', () => fi.click());
fi.addEventListener('change', (e) => processExcel(e.target.files[0]));

function processExcel(file) {
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(evt) {
    const binary = new Uint8Array(evt.target.result);
    const wb = XLSX.read(binary, {type: 'array'});
    const sheet = wb.Sheets[wb.SheetNames[0]];
    const rows = XLSX.utils.sheet_to_json(sheet);

    rows.forEach(r => {
      appData.sales.push({
        date: r.Date || new Date().toISOString().split('T')[0],
        produit: r.Produit || r.PRODUIT || 'Produit Inconnu',
        zone: r.Zone || r.ZONE || 'Zone Inconnue',
        marche: r.Marche || r.MARCHE || r.Marché || 'Général',
        prises: Number(r.Prises || r.PRISES) || 0,
        versements: Number(r.Versements || r.VERSEMENTS) || 0
      });
    });

    saveData();
    goTo('dashboard');
  };
  reader.readAsArrayBuffer(file);
}

// Horloge
setInterval(() => {
  const d = new Date();
  document.getElementById('clockTime').innerText = d.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
  document.getElementById('clockDate').innerText = d.toLocaleDateString();
}, 1000);

// Lancement au chargement
